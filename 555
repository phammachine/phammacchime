<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>อลิสจะยอมเป็นแฟนกับปอโต้ไหม</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@400;600;700&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --peach:#FCE7DE;
    --peach-deep:#F6D2C6;
    --paper:#FFFCF6;
    --ink:#4A3340;
    --ink-soft:#7A6270;
    --berry:#EE6E8E;
    --butter:#FFD08A;
    --mint:#9FD4C0;
    --line:#E0BBB0;
    --shadow:rgba(120,70,80,.16);

    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    color-scheme:light;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --peach:#2E2029; --peach-deep:#3A2833; --paper:#3D2B36;
      --ink:#FBEDE7; --ink-soft:#D0B2BF; --berry:#F58AA5;
      --butter:#E8B871; --mint:#8FC7B2; --line:#6B4A59;
      --shadow:rgba(0,0,0,.4); color-scheme:dark;
    }
  }
  :root[data-theme="dark"]{
    --peach:#2E2029; --peach-deep:#3A2833; --paper:#3D2B36;
    --ink:#FBEDE7; --ink-soft:#D0B2BF; --berry:#F58AA5;
    --butter:#E8B871; --mint:#8FC7B2; --line:#6B4A59;
    --shadow:rgba(0,0,0,.4); color-scheme:dark;
  }
  *,*::before,*::after{box-sizing:inherit}
  html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
  body{
    margin:0;
    background:
      radial-gradient(1100px 520px at 50% -180px, var(--peach-deep), transparent 70%),
      var(--peach);
    color:var(--ink);
    font-family:"IBM Plex Sans Thai Looped","Noto Sans Thai",system-ui,sans-serif;
    font-size:17px;line-height:1.85;overflow-x:hidden;min-height:100%;
  }
  h1,h2,.mali{font-family:"Mali","IBM Plex Sans Thai Looped",cursive}
  :focus-visible{outline:3px solid var(--berry);outline-offset:3px;border-radius:8px}

  .wrap{max-width:660px;margin:0 auto;padding:0 22px 90px}

  .drift{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
  .drift span{position:absolute;font-size:22px;opacity:.5;animation:float 22s linear infinite}
  @keyframes float{0%{transform:translateY(110vh) rotate(0)}100%{transform:translateY(-20vh) rotate(320deg)}}

  .scene{position:relative;z-index:1;text-align:center;padding:54px 0 8px}
  .catbox{width:min(300px,74vw);margin:0 auto;display:block}
  .cat-pop{transform-origin:50% 100%;animation:pop .9s cubic-bezier(.2,1.5,.4,1) .15s both}
  @keyframes pop{0%{transform:translateY(34px) scale(.82)}100%{transform:translateY(0) scale(1)}}
  .tail{transform-origin:14px 96px;animation:tail 3.2s ease-in-out 1.1s infinite}
  @keyframes tail{0%,100%{transform:rotate(0)}50%{transform:rotate(-13deg)}}
  .blink{animation:blink 6s infinite}
  @keyframes blink{0%,94%,100%{transform:scaleY(1)}97%{transform:scaleY(.1)}}
  .heartbeat{transform-origin:110px 140px;animation:beat 1.6s ease-in-out 1.2s infinite}
  @keyframes beat{0%,100%{transform:scale(1)}30%{transform:scale(1.12)}45%{transform:scale(1)}}

  h1{font-size:clamp(27px,7vw,40px);line-height:1.45;font-weight:700;margin:22px 0 6px}
  .lede{color:var(--ink-soft);margin:0 auto;max-width:34ch}

  .btn{
    font-family:"Mali",cursive;font-size:18px;font-weight:600;
    border:2.5px solid var(--ink);border-radius:999px;
    padding:13px 30px;cursor:pointer;color:var(--ink);
    background:var(--butter);box-shadow:0 5px 0 var(--ink);
    transition:transform .12s ease,box-shadow .12s ease;
  }
  .btn:active{transform:translateY(5px);box-shadow:0 0 0 var(--ink)}
  .btn.mint{background:var(--mint)}
  .btn.ghost{background:var(--paper)}
  .btn.berry{background:var(--berry);color:var(--paper)}
  .open-btn{margin:26px 0 0}

  .letter{
    position:relative;z-index:1;background:var(--paper);
    border:2.5px solid var(--line);border-radius:26px 26px 22px 22px;
    padding:34px 28px 30px;margin-top:34px;
    box-shadow:0 14px 34px var(--shadow);display:none;
  }
  .letter.show{display:block;animation:unfold .55s ease both}
  @keyframes unfold{from{opacity:0;transform:translateY(16px) rotate(-.6deg)}to{opacity:1;transform:none}}
  .tape{
    position:absolute;top:-15px;left:50%;transform:translateX(-50%) rotate(-2deg);
    background:var(--berry);color:var(--paper);
    font-family:"Mali",cursive;font-size:15px;font-weight:600;
    padding:4px 20px;border-radius:6px;white-space:nowrap;
  }
  .to{font-family:"Mali",cursive;font-size:23px;font-weight:600;margin:6px 0 14px}
  .body-text p{margin:0 0 15px;max-width:38ch}
  .sign{font-family:"Mali",cursive;font-size:20px;text-align:right;margin-top:22px;color:var(--berry)}

  .paws{list-style:none;padding:0;margin:26px 0 0;border-top:2px dashed var(--line);padding-top:22px}
  .paws li{display:flex;gap:12px;align-items:flex-start;margin-bottom:13px}
  .paws li::before{content:"🐾";flex:none;font-size:18px;line-height:1.7}
  .paws-head{font-family:"Mali",cursive;font-weight:600;margin:0 0 4px;color:var(--ink-soft)}

  .choices{position:relative;z-index:1;margin-top:34px;text-align:center;display:none;min-height:150px}
  .choices.show{display:block}
  .choices .q{font-family:"Mali",cursive;font-size:clamp(20px,5vw,25px);margin:0 0 20px;line-height:1.5}
  .row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;align-items:center}
  #yes{transition:transform .2s ease,font-size .2s ease}
  #no{transition:transform .28s cubic-bezier(.3,1.4,.5,1)}

  .ending{position:relative;z-index:1;text-align:center;margin-top:40px;display:none}
  .ending.show{display:block;animation:unfold .5s ease both}
  .ending h2{font-size:27px;margin:14px 0 8px}
  .ending p{color:var(--ink-soft);margin:0 auto;max-width:30ch}

  .burst{position:fixed;inset:0;pointer-events:none;z-index:9;overflow:hidden}
  .burst i{position:absolute;font-size:26px;animation:up 2.4s ease-out forwards}
  @keyframes up{
    0%{transform:translateY(0) scale(.5);opacity:0}
    15%{opacity:1}
    100%{transform:translateY(-95vh) scale(1.1) rotate(40deg);opacity:0}
  }

  .edit-open{
    position:fixed;z-index:5;
    top:calc(14px + env(safe-area-inset-top,0px));right:14px;
    width:46px;height:46px;border-radius:50%;
    border:2.5px solid var(--ink);background:var(--paper);color:var(--ink);
    font-size:19px;cursor:pointer;box-shadow:0 4px 0 var(--ink);
  }
  dialog{
    border:2.5px solid var(--ink);border-radius:22px;padding:0;
    background:var(--paper);color:var(--ink);
    width:min(520px,92vw);box-shadow:0 20px 50px var(--shadow);
  }
  dialog::backdrop{background:rgba(74,51,64,.45)}
  .panel{padding:26px 24px}
  .panel h2{font-size:22px;margin:0 0 4px}
  .panel .hint{color:var(--ink-soft);font-size:15px;margin:0 0 18px}
  label{display:block;font-size:15px;color:var(--ink-soft);margin:14px 0 5px}
  input,textarea{
    width:100%;font:inherit;font-size:16px;color:var(--ink);
    background:var(--peach);border:2px solid var(--line);border-radius:14px;
    padding:10px 13px;resize:vertical;
  }
  textarea{min-height:120px;line-height:1.7}
  .panel-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:22px}
  .panel-actions .btn{font-size:16px;padding:10px 22px}

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
  }
</style>
</head>
<body>

<div class="drift" aria-hidden="true"></div>
<div class="burst" id="burst" aria-hidden="true"></div>

<button class="edit-open" id="editOpen" title="แก้ข้อความ" aria-label="แก้ข้อความ">✎</button>

<main class="wrap">

  <section class="scene">
    <svg class="catbox cat-pop" viewBox="0 0 220 190" role="img" aria-label="แมวนั่งในกล่องกอดหัวใจ">
      <ellipse cx="110" cy="176" rx="76" ry="9" fill="var(--shadow)"/>
      <path class="tail" d="M42 150 C10 148 6 120 22 108 C30 102 40 108 36 118 C32 128 40 136 52 136" fill="none" stroke="var(--ink)" stroke-width="7" stroke-linecap="round"/>
      <g>
        <path d="M74 60 L70 26 L98 44 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round"/>
        <path d="M146 60 L150 26 L122 44 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round"/>
        <path d="M78 52 L76 36 L90 46 Z" fill="var(--berry)" opacity=".55"/>
        <path d="M142 52 L144 36 L130 46 Z" fill="var(--berry)" opacity=".55"/>
        <ellipse cx="110" cy="80" rx="46" ry="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="5"/>
        <g class="blink" style="transform-origin:94px 78px"><circle cx="94" cy="78" r="5.5" fill="var(--ink)"/></g>
        <g class="blink" style="transform-origin:126px 78px"><circle cx="126" cy="78" r="5.5" fill="var(--ink)"/></g>
        <ellipse cx="78" cy="90" rx="8" ry="5" fill="var(--berry)" opacity=".4"/>
        <ellipse cx="142" cy="90" rx="8" ry="5" fill="var(--berry)" opacity=".4"/>
        <path d="M104 90 h12 l-6 6 Z" fill="var(--berry)"/>
        <path d="M110 96 c0 5 -6 7 -9 4 M110 96 c0 5 6 7 9 4" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
        <path d="M62 78 h-16 M62 88 h-15 M158 78 h16 M158 88 h15" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
      </g>
      <path d="M40 120 L28 104 L70 112 Z" fill="var(--butter)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round"/>
      <path d="M180 120 L192 104 L150 112 Z" fill="var(--butter)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round"/>
      <path d="M44 116 h132 l-10 54 h-112 Z" fill="var(--butter)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round"/>
      <g class="heartbeat">
        <path d="M110 154 C 88 140 86 126 96 122 C 103 119 109 124 110 128 C 111 124 117 119 124 122 C 134 126 132 140 110 154 Z"
              fill="var(--berry)" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round"/>
      </g>
      <path d="M72 132 c-10 4 -10 20 2 22" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round"/>
      <path d="M148 132 c10 4 10 20 -2 22" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round"/>
    </svg>

    <h1 id="headline">อลิส… ปอโต้มีอะไรจะถาม</h1>
    <p class="lede">แมวตัวนี้ซ้อมมาทั้งอาทิตย์แล้ว กดเปิดให้หน่อยนะ</p>
    <button class="btn berry open-btn" id="openBtn">เปิดจดหมาย</button>
  </section>

  <section class="letter" id="letter" aria-live="polite">
    <span class="tape">ใจเต้นแรงมากตอนพิมพ์</span>
    <p class="to">ถึง <span id="toName">อลิส</span></p>
    <div class="body-text" id="bodyText"></div>
    <p class="sign">จาก <span id="fromName">ปอโต้</span> 🐾</p>

    <ul class="paws" id="paws">
      <li class="paws-head" style="display:block">สัญญาไว้สามข้อ</li>
    </ul>
  </section>

  <section class="choices" id="choices">
    <p class="q" id="question">อลิสจะยอมเป็นแฟนกับปอโต้ไหม</p>
    <div class="row">
      <button class="btn berry" id="yes">ยอม 🤍</button>
      <button class="btn ghost" id="no">ไม่ยอม</button>
    </div>
  </section>

  <section class="ending" id="ending">
    <svg width="130" height="115" viewBox="0 0 120 110" role="img" aria-label="แมวดีใจ">
      <ellipse cx="60" cy="102" rx="40" ry="6" fill="var(--shadow)"/>
      <path d="M34 44 L31 18 L52 32 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="4.5" stroke-linejoin="round"/>
      <path d="M86 44 L89 18 L68 32 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="4.5" stroke-linejoin="round"/>
      <ellipse cx="60" cy="62" rx="36" ry="34" fill="var(--paper)" stroke="var(--ink)" stroke-width="4.5"/>
      <path d="M44 56 c3 -5 9 -5 12 0 M64 56 c3 -5 9 -5 12 0" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
      <ellipse cx="36" cy="70" rx="7" ry="4.5" fill="var(--berry)" opacity=".45"/>
      <ellipse cx="84" cy="70" rx="7" ry="4.5" fill="var(--berry)" opacity=".45"/>
      <path d="M50 70 h20 c0 9 -20 9 -20 0 Z" fill="var(--berry)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M96 60 c11 -7 15 6 6 13" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
      <path d="M18 60 c-11 -7 -15 6 -6 13" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
    </svg>
    <h2 id="endTitle">ปอโต้ดีใจที่สุดเลย</h2>
    <p id="endText">ตั้งแต่วันนี้ไป ฝากเนื้อฝากตัวด้วยนะ 🤍</p>
  </section>

</main>

<dialog id="editor">
  <form method="dialog" class="panel">
    <h2>แก้ข้อความ</h2>
    <p class="hint">เปลี่ยนชื่อกับคำพูดเป็นของตัวเองได้ เก็บไว้ในเครื่องนี้เครื่องเดียว</p>

    <label for="fTo">ชื่อคนที่จะถาม</label>
    <input id="fTo" maxlength="40">

    <label for="fFrom">ชื่อเรา</label>
    <input id="fFrom" maxlength="40">

    <label for="fHead">พาดหัวหน้าแรก</label>
    <input id="fHead" maxlength="80">

    <label for="fQ">คำถามตรงกลาง</label>
    <input id="fQ" maxlength="90">

    <label for="fBody">เนื้อจดหมาย (เว้นบรรทัดว่างเพื่อขึ้นย่อหน้าใหม่)</label>
    <textarea id="fBody"></textarea>

    <label for="fPaws">สัญญาสามข้อ (บรรทัดละข้อ)</label>
    <textarea id="fPaws" style="min-height:86px"></textarea>

    <div class="panel-actions">
      <button class="btn ghost" value="cancel" type="submit">ยกเลิก</button>
      <button class="btn mint" value="save" type="submit">บันทึก</button>
    </div>
  </form>
</dialog>

<script>
(function(){
  "use strict";

  var KEY = "cat-ask-out-v1";

  var DEFAULTS = {
    to: "อลิส",
    from: "ปอโต้",
    head: "อลิส… ปอโต้มีอะไรจะถาม",
    q: "อลิสจะยอมเป็นแฟนกับปอโต้ไหม",
    body: [
      "ปอโต้คิดอยู่นานมากว่าจะพูดยังไงดี สุดท้ายก็เลือกวิธีนี้ เพราะพิมพ์แล้วมือไม่สั่นเท่าพูดต่อหน้า",
      "ทุกวันที่ได้คุยกับอลิส มันเป็นช่วงที่ปอโต้ยิ้มง่ายที่สุดของวันเลย อยู่ด้วยแล้วไม่ต้องเป็นใครอื่นนอกจากตัวเอง",
      "เลยอยากขอเปลี่ยนสถานะจากคนที่คุยกันทุกวัน เป็นคนที่ได้ดูแลกันจริง ๆ สักที"
    ].join("\n\n"),
    paws: [
      "จะฟังให้จบก่อนเสมอ ไม่ว่าจะเรื่องเล็กแค่ไหน",
      "ง้อก่อนทุกครั้ง ถึงจะยังงอนอยู่ก็ตาม",
      "พาไปกินของอร่อยได้ทุกเวลา แค่บอกมา"
    ].join("\n")
  };

  var el = function(id){ return document.getElementById(id); };
  var data = Object.assign({}, DEFAULTS);

  try {
    var saved = localStorage.getItem(KEY);
    if (saved) data = Object.assign(data, JSON.parse(saved));
  } catch (e) {}

  function render(){
    el("toName").textContent   = data.to   || DEFAULTS.to;
    el("fromName").textContent = data.from || DEFAULTS.from;
    el("headline").textContent = data.head || DEFAULTS.head;
    el("question").textContent = data.q    || DEFAULTS.q;

    var box = el("bodyText");
    box.innerHTML = "";
    (data.body || "").split(/\n\s*\n/).forEach(function(par){
      if (!par.trim()) return;
      var p = document.createElement("p");
      p.textContent = par.trim();
      box.appendChild(p);
    });

    var list = el("paws");
    list.querySelectorAll("li:not(.paws-head)").forEach(function(n){ n.remove(); });
    (data.paws || "").split("\n").forEach(function(line){
      if (!line.trim()) return;
      var li = document.createElement("li");
      li.textContent = line.trim();
      list.appendChild(li);
    });
    list.style.display = list.querySelector("li:not(.paws-head)") ? "" : "none";
  }

  (function(){
    var host = document.querySelector(".drift");
    ["🐾","🤍","🌸","🐾","💗","🎀"].forEach(function(m, i){
      var s = document.createElement("span");
      s.textContent = m;
      s.style.left = (6 + i * 16) + "%";
      s.style.animationDelay = (i * 3.6) + "s";
      s.style.animationDuration = (19 + i * 2) + "s";
      host.appendChild(s);
    });
  })();

  el("openBtn").addEventListener("click", function(){
    el("letter").classList.add("show");
    el("choices").classList.add("show");
    this.disabled = true;
    this.textContent = "เปิดแล้ว 🐾";
    this.style.opacity = ".55";
    setTimeout(function(){ el("letter").scrollIntoView({ block: "start" }); }, 80);
  });

  /* ปุ่ม "ไม่ยอม" หนี แล้วปุ่ม "ยอม" ก็โตขึ้นเรื่อย ๆ */
  var NO_LINES = ["ไม่ยอม","แน่ใจนะ","ขอคิดก่อน","แป๊บนึง","อย่าเพิ่งไป","ปอโต้เศร้าแล้วนะ"];
  var tries = 0;
  var no = el("no"), yes = el("yes");

  function scoot(){
    tries++;
    var x = (Math.random() * 2 - 1) * 100;
    var y = (Math.random() * 2 - 1) * 46;
    no.style.transform = "translate(" + x + "px," + y + "px) rotate(" + (x / 14) + "deg)";
    no.textContent = NO_LINES[Math.min(tries, NO_LINES.length - 1)];
    yes.style.fontSize = Math.min(18 + tries * 3, 34) + "px";
    if (tries >= 6){
      no.style.display = "none";
      yes.textContent = "ยอมแล้ว 🤍";
    }
  }
  no.addEventListener("mouseenter", scoot);
  no.addEventListener("click", function(e){ e.preventDefault(); scoot(); });

  yes.addEventListener("click", function(){
    el("choices").classList.remove("show");
    el("ending").classList.add("show");
    hearts();
    setTimeout(function(){ el("ending").scrollIntoView({ block: "center" }); }, 60);
  });

  function hearts(){
    var host = el("burst");
    var marks = ["🤍","💗","🌸","🐾","💞","🎀"];
    for (var i = 0; i < 26; i++){
      (function(i){
        setTimeout(function(){
          var s = document.createElement("i");
          s.textContent = marks[i % marks.length];
          s.style.left = (Math.random() * 92 + 4) + "%";
          s.style.bottom = "-40px";
          s.style.fontSize = (20 + Math.random() * 18) + "px";
          s.style.animationDuration = (2 + Math.random() * 1.4) + "s";
          host.appendChild(s);
          setTimeout(function(){ s.remove(); }, 3600);
        }, i * 90);
      })(i);
    }
  }

  var dlg = el("editor");
  el("editOpen").addEventListener("click", function(){
    el("fTo").value = data.to;
    el("fFrom").value = data.from;
    el("fHead").value = data.head;
    el("fQ").value = data.q;
    el("fBody").value = data.body;
    el("fPaws").value = data.paws;
    if (typeof dlg.showModal === "function") dlg.showModal();
  });

  dlg.addEventListener("close", function(){
    if (dlg.returnValue !== "save") return;
    data = {
      to: el("fTo").value.trim() || DEFAULTS.to,
      from: el("fFrom").value.trim() || DEFAULTS.from,
      head: el("fHead").value.trim() || DEFAULTS.head,
      q: el("fQ").value.trim() || DEFAULTS.q,
      body: el("fBody").value.trim() || DEFAULTS.body,
      paws: el("fPaws").value.trim()
    };
    try { localStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {}
    render();
  });

  render();
})();
